# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# cc65 build output (rebuilt by mb_basic\build.bat): object files, libraries, maps, labels, listings, debug info.
# The finished player goes to dist/ (dist/MPLAY.bin and dist/MPLAY.lbl are kept, see below).
build/
*.o
*.obj
*.a
*.lib
*.lst
*.map
*.lbl
*.dbg
*.d

# Generated audio and converter output
*.wav
mbf_out/

# MAME state, logs and temporary disk copies from the tests
mame/
*.log

# Disk images: keep the real disk (src/dist/mb.dsk), ignore any other .dsk
*.dsk
!dist/mb.dsk
!dist/MPLAY.bin
!dist/MPLAY.lbl
!mb_disk/dos33blank.dsk
*.dsk.bak

# Editors and OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
Desktop.ini


# Mac and Linux builds come from CI (or build_exe.sh); only the Windows exe is committed
dist/MockingboardStudio.app/
dist/MockingboardStudio-linux
